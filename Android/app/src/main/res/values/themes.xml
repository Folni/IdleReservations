<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.IdleReservations" parent="Theme.Material3.Light.NoActionBar">
        <!-- Brand colours -->
        <item name="colorPrimary">@color/idle_cyan</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/idle_cyan_light</item>
        <item name="colorOnPrimaryContainer">@color/idle_cyan_dark</item>

        <item name="colorSecondary">@color/idle_purple</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/idle_purple_light</item>
        <item name="colorOnSecondaryContainer">@color/idle_purple_dark</item>

        <item name="colorTertiary">@color/idle_purple</item>
        <item name="colorOnTertiary">@color/white</item>

        <!-- Backgrounds and surfaces -->
        <item name="android:colorBackground">@color/idle_background</item>
        <item name="colorSurface">@color/idle_surface</item>
        <item name="colorOnSurface">@color/idle_text_primary</item>
        <item name="colorSurfaceVariant">@color/idle_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/idle_text_secondary</item>
        <item name="colorOnBackground">@color/idle_text_primary</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/idle_navy</item>
        <item name="android:navigationBarColor">@color/idle_navy</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <style name="Theme.IdleReservations" parent="Base.Theme.IdleReservations" />
</resources>
