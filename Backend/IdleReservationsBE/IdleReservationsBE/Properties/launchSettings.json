{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://localhost:5005",
      "sslPort": 44305
    }
  },
  "profiles": {
    "IdleReservations Development": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
