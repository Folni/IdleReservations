  "components": {
    "schemas": {
      "ReservationCreateDto": {
        "required": [
          "partySize",
          "reservationDateTime",
          "restaurantId",
          "tableId",
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "restaurantId": {
            "type": "integer",
            "format": "int32"
          },
          "tableId": {
            "type": "integer",
            "format": "int32"
          },
          "reservationDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "partySize": {
            "maximum": 20,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "RestaurantCreateDto": {
        "required": [
          "address",
          "city",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 2,
            "type": "string"
          },
          "address": {
            "minLength": 1,
            "type": "string"
          },
          "city": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "TableCreateDto": {
        "required": [
          "restaurantId",
          "seats"
        ],
        "type": "object",
        "properties": {
          "restaurantId": {
            "type": "integer",
            "format": "int32"
          },
          "seats": {
            "maximum": 20,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "UserChangePasswordDto": {
        "required": [
          "newPassword",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "minLength": 1,
            "type": "string"
          },
          "newPassword": {
            "maxLength": 256,
            "minLength": 8,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UserLoginDto": {
        "required": [
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UserPromoteDto": {
        "required": [
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UserRegisterDto": {
        "required": [
          "email",
          "firstName",
          "lastName",
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "maxLength": 50,
            "minLength": 3,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 256,
            "minLength": 8,
            "type": "string"
          },
          "firstName": {
            "maxLength": 50,
            "minLength": 2,
            "type": "string"
          },
          "lastName": {
            "maxLength": 50,
            "minLength": 2,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Please enter valid JWT",
